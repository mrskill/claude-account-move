#!/usr/bin/env python3
"""Entry point: claude-account-move prepare | finish | sync."""
import os
import sys

# Never write bytecode caches: the tool must not create files outside its state
# directory, not even through the interpreter.
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from claude_account_move.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
